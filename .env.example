############### GLOBAL ###############
APPDATA_PATH=<appdata_absolute_path_here>
DATA_PATH=<data_absolute_path_here>
UID=<your_uid>
GUID=<your_guid>
TZ=<yout_timezone> # visit https://en.wikipedia.org/wiki/List_of_tz_database_time_zones#List

############### IMMICH ###############
# You can find documentation for all the supported env variables at https://docs.immich.app/install/environment-variables
UPLOAD_LOCATION=${DATA_PATH}/immich
DB_DATA_LOCATION=${APPDATA_PATH}/immich/postgres
TZ=${TZ}
IMMICH_VERSION=<release>
DB_PASSWORD=<your_password_here> # Please use only the characters `A-Za-z0-9`, without special characters or spaces
# The values below do not need to be changed
DB_USERNAME=postgres
DB_DATABASE_NAME=immich

############### VPN ###############
# WireGuard Credentials
VPN_PRIVATE_KEY=<vpn_private_key_here>
VPN_ADDRESS=<address>
VPN_COUNTRY=<country>
VPN_CITY=<city>
